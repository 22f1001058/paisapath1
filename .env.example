# PaisaPath — inference provider configuration.
#
#   cp .env.example .env      then fill in the ONE provider you intend to use.
#
# .env is gitignored. Nothing in this file is read by the browser: keys stay in
# the Node process and are used only to sign the outgoing inference request.
# Every value below is a placeholder — none of them are real keys.
#
# You do not need any of this to run the app. With no .env at all PaisaPath
# drives whichever agent CLI you already have installed (claude / codex /
# gemini), and if none answers, every screen still works from the built-in
# rules — the rupee figures are computed locally either way.

# ---------------------------------------------------------------- which one
# Name of the provider to use on first run. Also switchable at runtime in
# Trust centre → The AI engine.
# One of: claude codex gemini openai anthropic google openrouter groq deepseek
#         mistral together xai ollama  (or a name you define in AI_PROVIDERS)
AI_PROVIDER=claude

# ---------------------------------------------------------------- hosted APIs
# Uncomment and fill in only the one you use.

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-REPLACE_ME
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini — https://aistudio.google.com/apikey
# GOOGLE_API_KEY=REPLACE_ME
# GOOGLE_MODEL=gemini-2.0-flash

# OpenRouter (one key, hundreds of models) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-REPLACE_ME
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq — https://console.groq.com/keys
# GROQ_API_KEY=gsk_REPLACE_ME
# GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek
# DEEPSEEK_API_KEY=sk-REPLACE_ME
# DEEPSEEK_MODEL=deepseek-chat

# Mistral
# MISTRAL_API_KEY=REPLACE_ME
# MISTRAL_MODEL=mistral-small-latest

# Together AI
# TOGETHER_API_KEY=REPLACE_ME
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# xAI
# XAI_API_KEY=xai-REPLACE_ME
# XAI_MODEL=grok-2-latest

# ---------------------------------------------------------------- local models
# Ollama, LM Studio, llama.cpp, vLLM — no key needed, nothing leaves the machine.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------- anything else
# Any provider this repo has never heard of. Declare a name, then configure it
# with that name uppercased as the prefix.
#
# AI_PROVIDERS=vllm,work
#
# VLLM_BASE_URL=http://10.0.0.4:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct
# VLLM_API_KEY=REPLACE_ME            # optional for a local server
# VLLM_API=openai                    # wire format: openai | anthropic | google
# VLLM_LABEL=Lab GPU box             # what the Trust Centre calls it

# ---------------------------------------------------------------- knobs
# AI_MAX_TOKENS=2000                 # ceiling on one reply
# OPENAI_TEMPERATURE=0.3             # per-provider; omitted means the vendor default
# AI_CLI_CONCURRENCY=2               # parallel agent-CLI subprocesses
# AI_HTTP_CONCURRENCY=6              # parallel API requests

# ---------------------------------------------------------------- server
# PORT=8787
